# Database (used by API in Docker)
DATABASE_URL=postgresql://ngrestaurant:ngrestaurant@postgres:5432/ngrestaurant
POSTGRES_USER=ngrestaurant
POSTGRES_PASSWORD=ngrestaurant
POSTGRES_DB=ngrestaurant

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN_SECONDS=3600

# API
PORT=3000
NODE_ENV=development
